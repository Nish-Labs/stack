<page title="Link in bio — Stack template" theme="neon" favicon="/logo.svg">
<style>
.bio{max-width:420px;margin:0 auto;text-align:center;padding:3rem 1rem}
.bio .avatar{width:88px;height:88px;border-radius:50%;background:var(--surface-2);border:2px solid var(--border);margin:0 auto 1rem;display:flex;align-items:center;justify-content:center}
.bio h1{font-size:1.5rem;margin:0 0 .35rem}
.bio .handle{color:var(--muted);margin:0 0 1.5rem}
.bio .links a{display:block;padding:.9rem 1rem;margin:.6rem 0;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--text);text-decoration:none;font-weight:600}
.bio .links a:hover{border-color:var(--accent)}
</style>
<div class="bio">
  <div class="avatar"><icon name="user" size="36" /></div>
  <h1>Maya Chen</h1>
  <p class="handle">@maya · maker &amp; photographer</p>
  <div class="links">
    <a href="#">Portfolio</a>
    <a href="#">Shop prints</a>
    <a href="#">YouTube</a>
    <a href="#">Newsletter</a>
  </div>
  <p style="margin-top:2rem"><themeswitch /></p>
</div>
</page>
