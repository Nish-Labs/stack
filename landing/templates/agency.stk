<page title="North Studio" theme="ocean" favicon="/logo.svg">
<style>
.case{overflow:hidden;padding:0!important}
.case img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
.case .body{padding:1.15rem 1.25rem}
.team img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:var(--radius);margin-bottom:.65rem}
.bar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid var(--border);margin-bottom:1rem;font-size:.88rem}
</style>
<navbar brand="North Studio" icon="hexagon" links="Work:#work, Services:#services, Team:#team" cta="Contact:#contact">
  <themeswitch />
</navbar>
<div class="bar">
  <span class="muted">Template · Agency</span>
  <div class="stk-row">
    <button size="sm" variant="secondary" href="/templates" icon="arrow-left">Gallery</button>
    <button size="sm" variant="secondary" icon="copy" on:click="navigator.clipboard.writeText('stk new my-site --template agency')">Copy CLI</button>
  </div>
</div>
<hero>
  <h1>Brand and product for ambitious teams</h1>
  <p class="lead">We partner on strategy, design and front-end delivery.</p>
  <button href="#contact" icon="mail">Start a project</button>
</hero>
<section id="work">
  <h2>Selected work</h2>
  <grid cols="2">
    <div class="stk-card case">
      <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&amp;q=80" alt="Atlas Health" loading="lazy" />
      <div class="body"><h3>Atlas Health</h3><p>Identity and marketing site for a telehealth startup.</p></div>
    </div>
    <div class="stk-card case">
      <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&amp;q=80" alt="Ledger" loading="lazy" />
      <div class="body"><h3>Ledger</h3><p>Design system and dashboard for a fintech scale-up.</p></div>
    </div>
  </grid>
</section>
<section id="services">
  <h2>Services</h2>
  <grid cols="3">
    <card icon="pen-tool" title="Brand">Naming, identity, guidelines</card>
    <card icon="layout" title="Product">UX, UI, prototypes</card>
    <card icon="code" title="Build">Static sites and design systems</card>
  </grid>
</section>
<section id="team">
  <h2>Team</h2>
  <grid cols="3">
    <div class="team">
      <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=400&amp;q=80" alt="" loading="lazy" />
      <h3>Ava Chen</h3>
      <p class="muted">Strategy</p>
    </div>
    <div class="team">
      <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=400&amp;q=80" alt="" loading="lazy" />
      <h3>Leo Martins</h3>
      <p class="muted">Design</p>
    </div>
    <div class="team">
      <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&amp;q=80" alt="" loading="lazy" />
      <h3>Sam Okonkwo</h3>
      <p class="muted">Engineering</p>
    </div>
  </grid>
</section>
<section id="contact">
  <h2>Contact</h2>
  <alert type="info">hello@north.studio</alert>
</section>
<footer>© North Studio. Built with Stack.</footer>
</page>
