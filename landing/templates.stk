<page title="Stack templates" description="12 ready-to-use Stack templates with real layouts and images." theme="midnight" favicon="/logo.svg">

<style>
.tpl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem;margin-top:1.75rem}
.tpl-card{border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:var(--surface);display:flex;flex-direction:column;transition:border-color .15s,box-shadow .15s}
.tpl-card:hover{border-color:var(--accent);box-shadow:var(--shadow)}
.tpl-img{aspect-ratio:16/10;overflow:hidden;background:var(--surface-2)}
.tpl-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}
.tpl-card:hover .tpl-img img{transform:scale(1.04)}
.tpl-body{padding:1.15rem 1.25rem 1.35rem;flex:1;display:flex;flex-direction:column;gap:.7rem}
.tpl-body h3{margin:0;font-size:1.12rem}
.tpl-body p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.45}
.tpl-cmd-row{display:flex;gap:.4rem;align-items:stretch}
.tpl-cmd{flex:1;font:500 .78rem var(--mono-font);background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:.55rem .7rem;overflow-x:auto;white-space:nowrap}
.tpl-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.15rem}
.copy-ok{color:#22c55e!important}
</style>

<navbar brand="Stack" icon="layers" links="Home:/, Templates:/templates, Themes:/themes, Docs:/docs">
  <themeswitch />
</navbar>

<state copied="" />

<section>
  <p class="muted" style="margin:0 0 .35rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em">Gallery</p>
  <h1>12 templates, ready to ship</h1>
  <p class="lead">Full layouts with images. Preview live, copy the CLI command, or open the source page.</p>

  <div class="tpl-grid">

    <div class="tpl-card">
      <a class="tpl-img" href="/templates/portfolio"><img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&amp;q=80" alt="Portfolio preview" loading="lazy" /></a>
      <div class="tpl-body">
        <h3>Portfolio</h3>
        <p>Project grid, case studies, about and contact.</p>
        <div class="tpl-cmd-row">
          <code class="tpl-cmd" id="cmd-portfolio">stk new my-site --template portfolio</code>
          <button size="sm" variant="secondary" icon="copy" on:click="navigator.clipboard.writeText(document.getElementById('cmd-portfolio').textContent);copied='portfolio'">Copy</button>
        </div>
        <div class="tpl-actions">
          <button href="/templates/portfolio" size="sm" icon="eye">Live preview</button>
        </div>
      </div>
    </div>

    <div class="tpl-card">
      <a class="tpl-img" href="/templates/blog"><img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=800&amp;q=80" alt="Blog preview" loading="lazy" /></a>
